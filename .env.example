# Weather API (https://www.weatherapi.com/) — server-side only
WEATHER_API_KEY=your_api_key_here

# Spotify (homepage marquee)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Goodreads shelf RSS (optional — defaults to mieras-xyz shelf)
GOODREADS_USER_ID=61686650
GOODREADS_SHELF=mieras-xyz

# Discogs (/feed Listen — collection)
DISCOGS_TOKEN=
DISCOGS_USERNAME=mieras

# Mixcloud (/feed Listen — mixtapes; public API, no OAuth)
MIXCLOUD_USERNAME=mieras

# Trakt + TMDB (/feed Watch section)
TRAKT_USERNAME=
TRAKT_CLIENT_ID=
TMDB_API_KEY=
