---
import { ClientRouter } from "astro:transitions";
import "../styles/global.scss";
import SeoMeta from "../components/SeoMeta.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import PageProgress from "../components/PageProgress.astro";

interface Props {
    title: string;
    description?: string;
}
const {
    title,
    description = "Maarten Mieras • Digital Designer, Rotterdam. Clear and intuitive digital products.",
} = Astro.props;
const canonicalURL = new URL(
    Astro.url.pathname,
    Astro.site ?? "https://mieras.xyz"
);
---

<!doctype html>
<html lang="en">
    <head>
        <link
            href="https://fonts.cdnfonts.com/css/neue-haas-grotesk-display-pro"
            rel="stylesheet"
        />
        <SeoMeta {title} {description} {canonicalURL} />
        <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
        <link
            rel="alternate"
            type="text/markdown"
            title="Markdown"
            href={canonicalURL.toString()}
        />
        <ClientRouter />
        <slot name="head" />
    </head>
    <body>
        <PageProgress />
        <a href="#main" class="skip-link">Skip to content</a>
        <div class="page" data-page>
            <slot />
        </div>
        <div class="theme-toggle-fixed" transition:persist="theme-toggle">
            <ThemeToggle />
        </div>
        <style>
            .theme-toggle-fixed {
                position: fixed;
                bottom: 14px;
                right: 14px;
                z-index: 9999;
            }
        </style>
        <script is:inline>
            (() => {
                const apply = () => {
                    try {
                        const stored = localStorage.getItem("theme");
                        const prefersDark = window.matchMedia(
                            "(prefers-color-scheme: dark)"
                        ).matches;
                        if (stored === "light" || stored === "dark") {
                            document.documentElement.setAttribute(
                                "data-theme",
                                stored
                            );
                        } else {
                            document.documentElement.setAttribute(
                                "data-theme",
                                prefersDark ? "dark" : "light"
                            );
                        }
                    } catch {}
                };
                apply();
                document.addEventListener("astro:after-swap", apply);
                window
                    .matchMedia("(prefers-color-scheme: dark)")
                    .addEventListener("change", (e) => {
                        if (!localStorage.getItem("theme")) {
                            document.documentElement.setAttribute(
                                "data-theme",
                                e.matches ? "dark" : "light"
                            );
                        }
                    });
            })();
        </script>
        <script>
            import Lenis from "lenis";
            import gsap from "gsap";
            import { ScrollTrigger } from "gsap/ScrollTrigger";
            import "../lib/transitions";

            gsap.registerPlugin(ScrollTrigger);

            const lenis = new Lenis({ lerp: 0.08, smoothWheel: true });
            (window as unknown as { lenis?: Lenis }).lenis = lenis;

            function raf(time: number) {
                lenis.raf(time);
                // Keep ScrollTrigger in sync with Lenis's interpolated scroll position
                ScrollTrigger.update();
                requestAnimationFrame(raf);
            }
            requestAnimationFrame(raf);

            document.addEventListener("astro:page-load", () => {
                lenis.scrollTo(0, { immediate: true });
                lenis.start();
                ScrollTrigger.refresh();
            });
        </script>
    </body>
</html>
