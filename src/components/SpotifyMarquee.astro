---
import type { SpotifyTrack } from "../lib/spotify";

interface Props {
    tracks: SpotifyTrack[];
    backgroundColor?: string;
    textColor?: string;
    speed?: number;
}

const {
    tracks,
    backgroundColor = "#1DB954",
    textColor = "var(--color-bg)",
    speed = 35,
} = Astro.props;

// Duplicate so the strip always fills the viewport for seamless wrap
const copies = Array(3).fill(null);
---

{
    tracks.length > 0 && (
        <section
            class="spotify-marquee"
            style={{
                backgroundColor,
                "--spotify-text-color": textColor,
            }}
            data-speed={speed}
            aria-label="Recently played on Spotify"
        >
            <div class="spotify-marquee__label" aria-hidden="true">
                now playing
            </div>
            <div class="spotify-marquee__track">
                <div class="spotify-marquee__inner">
                    {copies.map((_, copyIndex) =>
                        tracks.map((track) => (
                            <a
                                class="spotify-marquee__item"
                                href={track.trackUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={`${track.artist} — ${track.title}`}
                                aria-hidden={copyIndex > 0 ? "true" : undefined}
                                tabindex={copyIndex > 0 ? -1 : undefined}
                            >
                                {track.albumArt && (
                                    <img
                                        class="spotify-marquee__thumb"
                                        src={track.albumArt}
                                        alt=""
                                        aria-hidden="true"
                                        width="48"
                                        height="48"
                                        loading="eager"
                                        decoding="async"
                                    />
                                )}
                                <span class="spotify-marquee__text">
                                    {track.artist} • {track.title}
                                </span>
                            </a>
                        ))
                    )}
                </div>
            </div>
        </section>
    )
}

<script>
    import gsap from "gsap";
    import { Draggable } from "gsap/Draggable";
    import { InertiaPlugin } from "gsap/InertiaPlugin";

    gsap.registerPlugin(Draggable, InertiaPlugin);

    type Cleanup = () => void;
    const cleanups: Cleanup[] = [];

    // Tear down previous inits (HMR / re-runs) so timelines don't stack
    const prev = (window as unknown as { __spotifyMarqueeCleanup?: Cleanup })
        .__spotifyMarqueeCleanup;
    prev?.();

    function init(): Cleanup | null {
        const section = document.querySelector<HTMLElement>(".spotify-marquee");
        if (!section) return null;

        const inner = section.querySelector<HTMLElement>(
            ".spotify-marquee__inner"
        );
        if (!inner) return null;

        // Reset any leftover transforms from a previous engine
        gsap.set(inner.querySelectorAll(".spotify-marquee__item"), {
            clearProps: "transform,x,xPercent",
        });
        gsap.set(inner, { x: 0, clearProps: "transform" });

        const speed = parseFloat(section.dataset.speed ?? "35");
        const pps = (30 / speed) * 200; // pixels per second (same mapping as MarqueeSection)
        const singleWidth = inner.scrollWidth / 3;
        if (singleWidth <= 0) return null;

        let pos = 0;
        let dirTarget = 1;
        let dir = 1;
        let isHovering = false;
        let wasPlaying = true;

        const wrap = (v: number) => {
            let next = v;
            while (next < -singleWidth) next += singleWidth;
            while (next > 0) next -= singleWidth;
            return next;
        };

        const apply = () => {
            pos = wrap(pos);
            inner.style.transform = `translateX(${pos}px)`;
        };

        const tickerFn = (_time: number, deltaTime: number) => {
            if (d?.isDragging || d?.isThrowing) return;

            const vel =
                (window as unknown as { lenis?: { velocity: number } }).lenis
                    ?.velocity ?? 0;

            if (vel > 0.5) dirTarget = 1;
            else if (vel < -0.5) dirTarget = -1;

            dir += ((isHovering ? 0 : dirTarget) - dir) * 0.08;
            pos -= pps * (deltaTime / 1000) * dir;
            apply();
        };

        gsap.ticker.add(tickerFn);

        const proxy = document.createElement("div");
        let startPos = 0;
        let d: Draggable | null = null;

        d = Draggable.create(proxy, {
            trigger: inner,
            type: "x",
            cursor: "none",
            activeCursor: "none",
            inertia: true,
            overshootTolerance: 0,
            onPressInit() {
                wasPlaying = !isHovering;
                gsap.killTweensOf(proxy);
                startPos = pos;
                gsap.set(proxy, { x: 0 });
            },
            onDrag() {
                pos = startPos + (this.x as number);
                apply();
            },
            onThrowUpdate() {
                pos = startPos + (this.x as number);
                apply();
            },
            onRelease() {
                requestAnimationFrame(() => {
                    if (!d?.isThrowing) {
                        // snap into continuous scroll space
                        startPos = pos;
                        gsap.set(proxy, { x: 0 });
                    }
                });
            },
            onThrowComplete() {
                startPos = pos;
                gsap.set(proxy, { x: 0 });
            },
        })[0];

        const onEnter = () => {
            isHovering = true;
        };
        const onLeave = () => {
            isHovering = false;
        };
        section.addEventListener("mouseenter", onEnter);
        section.addEventListener("mouseleave", onLeave);

        return () => {
            gsap.ticker.remove(tickerFn);
            d?.kill();
            section.removeEventListener("mouseenter", onEnter);
            section.removeEventListener("mouseleave", onLeave);
            gsap.set(inner, { clearProps: "transform" });
            gsap.set(inner.querySelectorAll(".spotify-marquee__item"), {
                clearProps: "transform,x,xPercent",
            });
        };
    }

    const run = async () => {
        await document.fonts.ready;
        const imgs = Array.from(
            document.querySelectorAll<HTMLImageElement>(
                ".spotify-marquee__thumb"
            )
        );
        await Promise.all(
            imgs.map((img) =>
                img.decode().catch(() => undefined)
            )
        );

        const cleanup = init();
        if (cleanup) {
            cleanups.push(cleanup);
            (
                window as unknown as { __spotifyMarqueeCleanup?: Cleanup }
            ).__spotifyMarqueeCleanup = () => {
                cleanups.splice(0).forEach((fn) => fn());
            };
        }
    };

    run();

    if (import.meta.hot) {
        import.meta.hot.dispose(() => {
            (
                window as unknown as { __spotifyMarqueeCleanup?: Cleanup }
            ).__spotifyMarqueeCleanup?.();
        });
    }
</script>

<style>
    .spotify-marquee {
        --marquee-rotate: 0deg;
        --marquee-x: 0px;
        --marquee-y: 0px;
        position: relative;
        z-index: 1;
        padding: var(--space-2xs) 0;
        display: flex;
        align-items: center;
        overflow: hidden;
        border-radius: var(--space-2xs, 0.5rem);
        margin: 0 var(--space-2xs) var(--space-s);
        transform: translate3d(var(--marquee-x), var(--marquee-y), 0)
            rotate(var(--marquee-rotate));
        transform-origin: center;
        transition: transform 320ms ease;
    }

    @media (min-width: 1280px) {
        .spotify-marquee {
            min-height: 10vh;
        }
    }

    .spotify-marquee__label {
        position: absolute;
        left: var(--space-xs);
        top: 50%;
        transform: translateY(-50%);
        flex-shrink: 0;
        align-self: stretch;
        display: flex;
        align-items: center;
        padding: var(--space-xs) var(--space-s);
        background-color: rgb(from var(--color-bg) r g b / 0.4);
        backdrop-filter: blur(var(--cursor-blur));
        color: var(--color-text);
        font-size: var(--step--1);
        font-weight: 500;
        white-space: nowrap;
        border-radius: 9999px;
        z-index: 1;
        pointer-events: none;
    }

    .spotify-marquee__track {
        width: 100%;
        overflow: hidden;
        cursor: grab;
        user-select: none;
    }

    .spotify-marquee__track:active {
        cursor: grabbing;
    }

    .spotify-marquee__inner {
        display: flex;
        width: max-content;
        align-items: center;
        will-change: transform;
    }

    .spotify-marquee__item {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        gap: var(--space-s);
        padding-right: 1em;
        color: var(--spotify-text-color);
        text-decoration: none;
        font-size: var(--step-5);
    }

    .spotify-marquee__item:hover {
        opacity: 0.85;
    }

    .spotify-marquee__item:active {
        opacity: 0.7;
    }

    .spotify-marquee__thumb {
        display: block;
        flex-shrink: 0;
        width: 0.75em;
        height: 0.75em;
        border-radius: var(--space-3xs);
        object-fit: cover;
    }

    .spotify-marquee__text {
        font-size: 1em;
        font-weight: 700;
        line-height: 100%;
        letter-spacing: -0.01em;
        white-space: nowrap;
    }
</style>
