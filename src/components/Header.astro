<header class="header" role="banner">
    <a href="/" class="header__name" rel="home">mieras.xyz</a>
    <nav class="header__nav" aria-label="Navigation">
        <a href="/#information" class="header__link header__link--info">info</a>
        <a href="/feed" class="header__link header__link--feed">feed</a>
    </nav>
</header>

<style scoped>
    .header {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-2xs, 2rem);
        align-items: center;
        position: relative;
        z-index: 1000;
        padding: 9px 14px;
    }
    .header__name {
        grid-column: 1 / 3;
        font-size: var(--step--1);
        font-weight: 450;
        color: var(--color-text);
        text-decoration: none;
        line-height: 1;
    }
    .header__name:hover {
        text-decoration: underline;
    }
    /* Children join the 4-col header grid so info/feed sit on the real column tracks */
    .header__nav {
        display: contents;
    }
    .header__link {
        font-size: var(--step--1);
        font-weight: 500;
        color: var(--color-text);
        text-decoration: none;
    }
    .header__link--info {
        grid-column: 3;
    }
    .header__link--feed {
        grid-column: 4;
    }
    .header__link:hover {
        text-decoration: underline;
    }
</style>
